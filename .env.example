NODE_ENV=<development-or-production>
PORT=<multiplayer-server-port>
HOST=<multiplayer-server-bind-address>
ALLOWED_ORIGINS=<comma-separated-browser-origin-allowlist>
TLS_CERT_FILE=<certificate-file-path-or-empty>
TLS_KEY_FILE=<private-key-file-path-or-empty>
MAX_CONNECTIONS=<maximum-websocket-connections>
SERVER_HOST=<multiplayer-server-host-used-by-development-proxy>
VITE_WS_URL=<public-wss-endpoint-or-empty-for-same-origin-proxy>
VITE_DEV_SERVER_HOST=<frontend-development-bind-address>
VITE_DEV_SERVER_PORT=<frontend-development-port>
VITE_PREVIEW_HOST=<production-preview-bind-address>
VITE_PREVIEW_PORT=<production-preview-port>
