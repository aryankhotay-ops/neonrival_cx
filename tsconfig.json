{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@neon-rival/simulation": [
        "./packages/simulation/src/index.ts"
      ],
      "@neon-rival/protocol": [
        "./packages/protocol/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts"
  ]
}
